<% data      = forecast_data(result.value[:forecast]) %>
<% condition = data[:weatherCondition] || {} %>
<% history   = data[:currentConditionsHistory] || {} %>

<div class="mt-6 overflow-hidden rounded-2xl bg-white shadow-xl shadow-slate-200/60 ring-1 ring-slate-200">
  <div class="flex items-start justify-between gap-4 bg-gradient-to-br from-blue-600 to-blue-500 px-6 py-5">
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-blue-100">
        <%= result.value[:label] %>
      </p>
      <p class="mt-1 text-lg font-medium text-white">
        <%= condition.dig(:description, :text) || "Current conditions" %>
      </p>
    </div>
    <% if result.value[:from_cache] %>
      <span class="shrink-0 rounded-full bg-white/15 px-2.5 py-1 text-xs font-medium text-blue-50 ring-1 ring-inset ring-white/30">
        Data retrieved from cache
      </span>
    <% end %>
  </div>

  <div class="flex items-center gap-5 px-6 py-6">
    <% if condition[:iconBaseUri].present? %>
      <%= image_tag "#{condition[:iconBaseUri]}.svg", alt: "", class: "h-16 w-16 shrink-0" %>
    <% end %>

    <div>
      <p class="text-5xl font-semibold tracking-tight text-slate-900">
        <%= temperature_text(data[:temperature]) %>
      </p>
      <p class="mt-1 text-sm text-slate-500">
        Feels like <%= temperature_text(data[:feelsLikeTemperature]) %>
      </p>
    </div>

    <div class="ml-auto text-right text-sm text-slate-500">
      <p>
        High <span class="font-medium text-slate-700"><%= temperature_text(history[:maxTemperature]) %></span>
      </p>
      <p class="mt-1">
        Low <span class="font-medium text-slate-700"><%= temperature_text(history[:minTemperature]) %></span>
      </p>
    </div>
  </div>

  <dl class="grid grid-cols-2 gap-px border-t border-slate-200 bg-slate-200 sm:grid-cols-4">
    <% {
         "Humidity"    => percent_text(data[:relativeHumidity]),
         "Wind"        => speed_text(data.dig(:wind, :speed)),
         "Rain chance" => percent_text(data.dig(:precipitation, :probability, :percent)),
         "UV index"    => data[:uvIndex] || "—"
       }.each do |label, value| %>
      <div class="bg-white px-4 py-3">
        <dt class="text-xs uppercase tracking-wide text-slate-400">
          <%= label %>
        </dt>
        <dd class="mt-1 text-sm font-medium text-slate-900">
          <%= value %>
        </dd>
      </div>
    <% end %>
  </dl>
</div>
